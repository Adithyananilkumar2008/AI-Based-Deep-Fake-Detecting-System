{
  "entities": {
    "ScanRecord": {
      "collection": "users/{userId}/scans",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "number" },
        "mediaType": { "type": "string" },
        "imageLabel": { "type": "string" },
        "syntheticRiskScore": { "type": "number" },
        "riskLevel": { "type": "string" },
        "elaScore": { "type": "number" },
        "summary": { "type": "string" },
        "isPreset": { "type": "boolean" }
