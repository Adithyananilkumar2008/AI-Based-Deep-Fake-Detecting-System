    },
    "UserProfile": {
      "collection": "users",
      "fields": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastActive": { "type": "number" }
      }
    }
  }
